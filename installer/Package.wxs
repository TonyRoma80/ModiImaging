<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!--
    Installer "dual-purpose": l'utente sceglie se installare
      - solo per sé  (predefinito): %LOCALAPPDATA%\Programs\MdiViewer, registro HKCU, nessun permesso di amministratore;
      - per tutti gli utenti:       C:\Program Files\MdiViewer, registro HKLM, richiede i permessi di amministratore.
    Le chiavi di registro usano la radice HKMU, che Windows Installer traduce in HKCU o HKLM secondo la scelta.

    UpgradeCode: NON cambiarlo mai, serve a Windows per riconoscere gli aggiornamenti.
  -->
  <Package Name="MdiViewer"
           Manufacturer="TonyRoma"
           Version="$(var.ProductVersion)"
           UpgradeCode="390D9C19-54E9-44C4-BD0E-FB3464C0F430"
           Language="1040"
           Codepage="1252"
           Scope="perUserOrMachine"
           Compressed="yes">

    <SummaryInformation Description="MdiViewer - visualizzatore e convertitore di file Microsoft Document Imaging (.mdi)" />

    <!-- Una nuova versione sostituisce automaticamente quella installata (nello stesso ambito: per utente o per computer). -->
    <MajorUpgrade DowngradeErrorMessage="È già installata una versione più recente di MdiViewer." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Icona in "Impostazioni > App" e collegamenti -->
    <Icon Id="MdiViewer.ico" SourceFile="$(var.RepoRoot)src\MdiViewer\MdiViewer.ico" />
    <Property Id="ARPPRODUCTICON" Value="MdiViewer.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/TonyRoma80/ModiImaging" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/TonyRoma80/ModiImaging" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/TonyRoma80/ModiImaging/releases" />

    <!-- In un'installazione per utente Windows Installer reindirizza ProgramFiles64Folder in %LOCALAPPDATA%\Programs. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="APPLICATIONFOLDER" Name="MdiViewer" />
    </StandardDirectory>

    <ComponentGroup Id="MdiViewerFiles" Directory="APPLICATIONFOLDER">
      <Component Id="MainExecutable" Bitness="always64">
        <File Id="MdiViewerExe" Source="$(var.ViewerDir)MdiViewer.exe" KeyPath="yes" />

        <!-- Associazione dei file .mdi: doppio clic e "Apri con" -->
        <ProgId Id="MdiViewer.mdi" Description="Documento Microsoft Document Imaging" Icon="MdiViewerExe" IconIndex="0">
          <Extension Id="mdi" ContentType="image/vnd.ms-modi">
            <Verb Id="open" Command="Apri con MdiViewer" TargetFile="MdiViewerExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <RegistryValue Root="HKMU" Key="Software\Classes\.mdi\OpenWithProgids" Name="MdiViewer.mdi" Value="" Type="string" />

        <!-- "Apri con" per gli altri formati supportati. Il comando serve anche a chi in passato ha scelto
             "Apri con > MdiViewer.exe > Usa sempre" con un'altra copia: la sua scelta punta a questa chiave. -->
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\MdiViewer.exe" Name="FriendlyAppName" Value="MdiViewer" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\MdiViewer.exe\shell\open\command" Value="&quot;[#MdiViewerExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\MdiViewer.exe\SupportedTypes" Name=".mdi" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\MdiViewer.exe\SupportedTypes" Name=".emf" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\MdiViewer.exe\SupportedTypes" Name=".tif" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\MdiViewer.exe\SupportedTypes" Name=".tiff" Value="" Type="string" />

        <!-- Registrazione tra le "App predefinite" di Windows (Impostazioni > App > App predefinite) -->
        <RegistryValue Root="HKMU" Key="Software\TonyRoma\MdiViewer\Capabilities" Name="ApplicationName" Value="MdiViewer" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\TonyRoma\MdiViewer\Capabilities" Name="ApplicationDescription" Value="Visualizzatore e convertitore di file Microsoft Document Imaging (.mdi)" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\TonyRoma\MdiViewer\Capabilities" Name="ApplicationIcon" Value="&quot;[#MdiViewerExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\TonyRoma\MdiViewer\Capabilities\FileAssociations" Name=".mdi" Value="MdiViewer.mdi" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\RegisteredApplications" Name="MdiViewer" Value="Software\TonyRoma\MdiViewer\Capabilities" Type="string" />
      </Component>

      <Component Id="LicenseFile">
        <File Id="LicenseTxt" Source="$(var.RepoRoot)LICENSE" Name="LICENSE.txt" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Collegamento nel menu Start (componente separato, come richiesto dalle regole di Windows Installer) -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="StartMenuShortcut"
                  Name="MdiViewer"
                  Description="Visualizzatore di file Microsoft Document Imaging (.mdi)"
                  Target="[APPLICATIONFOLDER]MdiViewer.exe"
                  WorkingDirectory="APPLICATIONFOLDER"
                  Icon="MdiViewer.ico" />
        <RegistryValue Root="HKCU" Key="Software\TonyRoma\MdiViewer" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="MdiViewer" Level="1">
      <ComponentGroupRef Id="MdiViewerFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Interfaccia: benvenuto, licenza, scelta "solo per me" / "per tutti gli utenti", cartella, avanzamento -->
    <Property Id="ApplicationFolderName" Value="MdiViewer" />
    <Property Id="WixAppFolder" Value="WixPerUserFolder" />
    <ui:WixUI Id="WixUI_Advanced" />
    <!-- WixUI_Advanced userebbe %LOCALAPPDATA%\Apps: si usa la cartella standard di Windows %LOCALAPPDATA%\Programs. -->
    <SetProperty Id="WixPerUserFolder" Value="[LocalAppDataFolder]Programs\[ApplicationFolderName]"
                 After="WixSetDefaultPerUserFolder" Sequence="both" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <!-- Al termine: casella "Avvia MdiViewer" -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Avvia MdiViewer" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="LaunchApplication" FileRef="MdiViewerExe" ExeCommand="" Return="asyncNoWait" Impersonate="yes" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>
  </Package>
</Wix>
