<Project>
  <!-- Impostazioni comuni a tutti i progetti della soluzione. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.1.1</Version>
    <Authors>TonyRoma</Authors>
    <Company>TonyRoma</Company>
    <Copyright>Copyright © 2026 TonyRoma</Copyright>
    <NeutralLanguage>it-IT</NeutralLanguage>
    <SatelliteResourceLanguages>it</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Metadati dei pacchetti NuGet (solo per le librerie in src/ModiImaging*). -->
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('ModiImaging'))">
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageTags>mdi;modi;microsoft-document-imaging;emf;text-extraction;ocr;pdf</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts\packages</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/TonyRoma80/ModiImaging</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TonyRoma80/ModiImaging.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <!-- Compilazione deterministica: lo stesso sorgente produce sempre gli stessi binari. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
